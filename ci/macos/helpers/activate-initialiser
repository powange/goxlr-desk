#!/bin/bash

echo $(whoami)
# This script should be run as sudo, as it configures the initialiser launch options..

# Install the launchctl services.

launchctl load -w /Library/LaunchDaemons/com.github.powange.goxlr-desk.initialiser.mini.plist
launchctl load -w /Library/LaunchDaemons/com.github.powange.goxlr-desk.initialiser.full.plist

# And for good measure, we'll perform an initial run of the initialiser..
'/Library/Application Support/com.github.powange.goxlr-desk/goxlr-initialiser'
